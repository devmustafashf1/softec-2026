PORT=5000
NODE_ENV=development

# Supabase — get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx   # safe for client-side too
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # backend only, never expose publicly

# Gmail SMTP (nodemailer)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-google-app-password
